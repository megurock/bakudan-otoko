{
  "name": "bakudan-otoko",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "predev": "vite build",
    "dev": "concurrently -k \"vite build --watch\" \"wrangler dev\"",
    "build": "vite build",
    "deploy": "pnpm build && wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.27.0"
  }
}
